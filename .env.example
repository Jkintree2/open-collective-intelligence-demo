# Neo4j connection URI. Locally the Docker database; on Render the URI from the Aura credentials file.
NEO4J_URI=neo4j://localhost:7687
# Neo4j user, usually neo4j.
NEO4J_USERNAME=neo4j
# Neo4j password. Locally localpass; on Render the password from the Aura credentials file.
NEO4J_PASSWORD=change-me
# Neo4j database name. Locally neo4j. On an Aura Free instance the only user database is named
# after the instance id (for example 1a2b3c4d), not neo4j; copy the id from the Aura console.
NEO4J_DATABASE=neo4j
# The shared passphrase testers type at the gate. The app refuses to start without it.
DEMO_PASSPHRASE=change-me
# Cookie signing secret. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Password for the back room (HTTP basic auth, added in Session 4). Generate like SECRET_KEY.
ADMIN_TOKEN=change-me
# Name shown in the header, on the gate and in the browser tab.
SITE_NAME=Open Collective Intelligence
# The sentence at the top of the write page.
SITE_SENTENCE=Write what you think about an issue that matters to you. We will pull out the issue, your claim, any evidence and any solution, show you what we found, and add it to a record everyone here shares.
# Reading service key (DeepSeek). Optional; nothing reads it until Session 3.
LLM_API_KEY=
# Reading service base URL, an OpenAI compatible chat completions endpoint.
LLM_BASE_URL=https://api.deepseek.com
# Reading service model id.
LLM_MODEL=deepseek-v4-flash
# local or production. local turns off the Secure cookie flag so http://localhost works.
APP_ENV=local
# Render only: the Python runtime Render installs. The app does not read it.
PYTHON_VERSION=3.12.14
